# ==============================================================================
# Master .gitignore for Cross-Border E-Commerce Pricing Intelligence Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
Lib/
Scripts/
share/

# ------------------------------------------------------------------------------
# 2. Testing, Code Coverage & Linting
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ------------------------------------------------------------------------------
# 3. Databases & Local Data Persistence
# ------------------------------------------------------------------------------
*.sqlite3
*.sqlite
*.db
*.db-journal
*.db-shm
*.db-wal
backend/*.db
data/*.db
data/cache/

# ------------------------------------------------------------------------------
# 4. Environment Variables & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json

# ------------------------------------------------------------------------------
# 5. Node.js, Frontend & Dependencies
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. Next.js Build Outputs & Caches
# ------------------------------------------------------------------------------
.next/
frontend/.next/
out/
frontend/out/
.turbo/
frontend/.turbo/
.vercel/

# TypeScript build cache
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 7. Operating System & IDE Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Antigravity / Gemini internal artifacts
.gemini/
.agents/
scratch/
