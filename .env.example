# Application Environment Configuration
APP_NAME="Cross-Border E-Commerce Pricing Intelligence"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000

# CORS Origins (Comma-separated list or JSON array)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Database Configuration (SQLite by default for zero-config local run, PostgreSQL supported)
DATABASE_URL="sqlite:///./pricing_intelligence.db"

# Foreign Exchange Rate Service
FX_API_URL="https://open.er-api.com/v6/latest/USD"
FX_CACHE_TTL_HOURS=12

# Scraping Engine Settings
SCRAPER_REQUEST_TIMEOUT=15
SCRAPER_MAX_RETRIES=3
SCRAPER_RATE_LIMIT_DELAY_MIN=1.0
SCRAPER_RATE_LIMIT_DELAY_MAX=2.5
SCRAPER_MAX_CONCURRENT_REQUESTS=5

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="console"
